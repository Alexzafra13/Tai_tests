# All settings are optional: the app works with none of them. Copy this file
# to .env and uncomment what you want to change.

# Port on the host (docker compose).
# TAI_PORT=8080

# Set to true when the app is reached over HTTPS (reverse proxy, Tailscale
# serve...). Keep false for plain http on your LAN or the login cookie is not
# sent.
# TAI_COOKIE_SECURE=false

# How long a login lasts (Go duration: 720h = 30 days).
# TAI_SESSION_TTL=720h

# Time zone that decides which day an answer counts for in the statistics
# (Atlantic/Canary in the Canary Islands).
# TAI_TZ=Europe/Madrid

# Create the first administrator without the setup screen (headless
# installs). Ignored once an administrator exists.
# TAI_ADMIN_USER=admin
# TAI_ADMIN_PASSWORD=

# Only when running the binary outside Docker:
# TAI_ADDR=:8080
# TAI_DB_PATH=tai.db
