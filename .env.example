# --- Server ---------------------------------------------------------------
# Login password (required, at least 8 characters). Single user, no signup.
TAI_PASSWORD=change-me-please

# Listen address.
TAI_ADDR=:8080

# SQLite database path. In Docker it lives on the /data volume.
TAI_DB_PATH=/data/tai.db

# Set to true when the app is served over HTTPS (reverse proxy, Tailscale
# serve...). Keep false for plain http on your LAN or the cookie won't be sent.
TAI_COOKIE_SECURE=false

# Session lifetime (Go duration: 720h = 30 days).
TAI_SESSION_TTL=720h

# --- AI content pipeline (used from phase 5 on; never in the study flow) ---
# ANTHROPIC_API_KEY=
# TAI_LLM_MODEL=claude-sonnet-5
